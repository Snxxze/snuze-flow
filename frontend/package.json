{
  "name": "snuzeflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:locales": "node scripts/check-locales.cjs",
    "preview": "vite preview",
    "gen:api": "cd .. && swag init -g backend/cmd/api/main.go -o ./docs/api --outputTypes yaml && npx openapi-typescript ./docs/api/swagger.yaml -o ./frontend/src/types/api.generated.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.6.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.359.0",
    "radix-ui": "^1.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.22.3",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "postcss": "^8.4.38",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}
