# การตั้งค่าเซิร์ฟเวอร์
PORT=8080
APP_ENV=development

# การตั้งค่าการเชื่อมต่อฐานข้อมูล (Database Configuration)
# ทางเลือกที่ 1: Local Docker PostgreSQL (ค่าเริ่มต้นสำหรับการพัฒนาบนเครื่อง Local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/snuzeflow?sslmode=disable

# ทางเลือกที่ 2: Neon Cloud PostgreSQL (สำหรับการขึ้นระบบ Staging / Production ในอนาคต)
# DATABASE_URL=postgres://username:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# การตั้งค่าระบบลงชื่อเข้าใช้ (JWT Authentication)
JWT_SECRET=snuze-flow-super-secret-key-change-in-prod-2026
JWT_EXPIRY_HOURS=24

# การตั้งค่าอนุญาตการเข้าถึงข้ามโดเมน (CORS Settings)
CORS_ALLOWED_ORIGIN=http://localhost:5173
